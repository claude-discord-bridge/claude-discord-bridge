#!/usr/bin/env bash
# dicobot - control the claude-discord-bridge launchd service
set -uo pipefail

LABEL="com.claude-discord"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"
# 심볼릭 링크로 설치되므로 링크를 따라가야 저장소 경로가 나온다.
REPO_DIR="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
TARGET="$DOMAIN/$LABEL"
LOG="$HOME/.claude-discord/bot.log"
ERRLOG="$HOME/.claude-discord/bot.err.log"

# Python logging goes to stderr, so bot.err.log carries the real event stream
# while bot.log is usually empty. Read both, newest content wins.
logfiles() {
  local f out=()
  for f in "$LOG" "$ERRLOG"; do
    [[ -s "$f" ]] && out+=("$f")
  done
  (( ${#out[@]} )) || out=("$ERRLOG")
  printf '%s\n' "${out[@]}"
}

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$*"; }
dim()   { printf '\033[2m%s\033[0m\n' "$*"; }

is_loaded() { launchctl print "$TARGET" >/dev/null 2>&1; }

svc_pid() {
  launchctl print "$TARGET" 2>/dev/null \
    | awk -F'= ' '/^[[:space:]]*pid = /{print $2; exit}'
}

svc_runs() {
  launchctl print "$TARGET" 2>/dev/null \
    | awk -F'= ' '/^[[:space:]]*runs = /{print $2+0; exit}'
}

svc_state() {
  launchctl print "$TARGET" 2>/dev/null \
    | awk -F'= ' '/^[[:space:]]*state = /{print $2; exit}'
}

# Count "logged in as" lines in the last N minutes. Repeated logins in a
# short window mean launchd is restarting a crashing process.
recent_logins() {
  local minutes="${1:-5}"
  [[ -s "$LOG" || -s "$ERRLOG" ]] || { echo 0; return; }
  local cutoff
  cutoff=$(date -v-"${minutes}"M '+%Y-%m-%d %H:%M:%S' 2>/dev/null) || { echo 0; return; }
  cat $(logfiles) 2>/dev/null | tail -n 500 \
    | grep 'logged in as' \
    | awk -v c="$cutoff" '{ ts = $1 " " substr($2,1,8); if (ts >= c) n++ } END { print n+0 }'
}

last_login_line() {
  cat $(logfiles) 2>/dev/null | grep 'logged in as' | tail -n 1
}

cmd_status() {
  if ! is_loaded; then
    red "● STOPPED  — launchd에 로드되지 않음"
    dim  "  시작: dicobot start"
    return 1
  fi

  local pid state logins
  pid=$(svc_pid); state=$(svc_state)

  if [[ -z "$pid" ]]; then
    red "● STOPPED  — 등록됨(state=${state:-?})이지만 프로세스 없음"
    dim  "  최근 에러: $(tail -n 3 "$ERRLOG" 2>/dev/null | tr '\n' ' ')"
    return 1
  fi

  # 로그인 횟수만 세면 손으로 여러 번 재시작한 것도 크래시 루프로 보인다.
  # launchd의 runs 는 지금 bootstrap 안에서 프로세스가 몇 번 떴는지라,
  # 손으로 bootout/bootstrap 하면 1로 돌아간다. 둘 다 높을 때만 단정한다.
  logins=$(recent_logins 5)
  if (( logins >= 3 )) && (( $(svc_runs) >= 3 )); then
    yellow "● CRASH LOOP  — pid $pid (5분 내 재로그인 ${logins}회, runs=$(svc_runs))"
    yellow "  launchd가 계속 재시작 중. 토큰/설정 확인 필요."
    dim    "  $(tail -n 3 "$ERRLOG" 2>/dev/null | tr '\n' ' ')"
    return 2
  fi

  green "● RUNNING  — pid $pid (state=$state)"
  dim   "  $(last_login_line)"
  return 0
}

cmd_start() {
  if is_loaded && [[ -n "$(svc_pid)" ]]; then
    yellow "이미 실행 중 (pid $(svc_pid))"
    return 0
  fi
  # plist가 없다는 말만 하고 끝내면, 7단계를 건너뛴 사람은 그 파일을 어디서
  # 어떻게 만드는지 모른 채 멈춘다. 만드는 명령을 그대로 보여준다.
  if [[ ! -f "$PLIST" ]]; then
    red "plist 없음: $PLIST"
    echo "  7단계(항상 켜져 있게 만들기)를 아직 안 했습니다. 설치:"
    echo "    cd $REPO_DIR"
    echo "    sed -e \"s|__REPO_DIR__|\$PWD|g\" -e \"s|__HOME_DIR__|\$HOME|g\" \\"
    echo "      deploy/com.claude-discord.plist > $PLIST"
    echo "    dicobot start"
    return 1
  fi
  launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null \
    || launchctl kickstart "$TARGET"
  sleep 2
  cmd_status
}

cmd_stop() {
  if ! is_loaded; then
    yellow "이미 정지됨"
    return 0
  fi
  launchctl bootout "$TARGET" 2>/dev/null
  sleep 1
  if is_loaded; then
    red "정지 실패"
    return 1
  fi
  green "● STOPPED"
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_start
}

cmd_log() {
  local n="${1:-40}"
  cat $(logfiles) 2>/dev/null | tail -n "$n"
}

cmd_tail() {
  tail -f $(logfiles)
}

cmd_help() {
  cat <<'EOF'
dicobot - claude-discord-bridge 제어

  dicobot              상태 확인 (기본)
  dicobot status       상태 확인
  dicobot start        시작
  dicobot stop         정지
  dicobot restart      재시작
  dicobot log [N]      로그 마지막 N줄 (기본 40)
  dicobot tail         로그 실시간
  dicobot help         이 도움말

start/stop/restart 는 -start / --start 형태도 받습니다.
EOF
}

# strip leading dashes so `-start` and `--start` work like `start`
raw="${1:-status}"
cmd="${raw#-}"; cmd="${cmd#-}"
shift 2>/dev/null || true

case "$cmd" in
  status|"")      cmd_status ;;
  start)          cmd_start ;;
  stop)           cmd_stop ;;
  restart)        cmd_restart ;;
  log|logs)       cmd_log "${1:-40}" ;;
  tail|follow|f)  cmd_tail ;;
  help|h)         cmd_help ;;
  *)              red "알 수 없는 명령: $raw"; echo; cmd_help; exit 1 ;;
esac
